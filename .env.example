# Hosted Postgres connection string (Neon / Vercel Postgres). Must be the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PayFast merchant credentials. Defaults below are PayFast's published SANDBOX test credentials -
# safe to use for testing, but replace with OGP Services' real merchant account before going live.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn

# "sandbox" (default) or "live"
PAYFAST_MODE=sandbox

# Public URL of the deployed site, used to build PayFast return/cancel/notify URLs.
# Required in production - without it PayFast can't reach the ITN webhook.
NEXT_PUBLIC_BASE_URL=https://your-domain.example
